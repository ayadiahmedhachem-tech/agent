@app.get("/")
def index():
    return render_template_string(HTML_PAGE)


@app.post("/chat")
def chat():

    if not request.is_json:
        return jsonify({
            "error": "La requête doit être au format JSON."
        }), 415

    data = request.get_json(silent=True) or {}

    message = data.get("message", "")

    if not isinstance(message, str):
        return jsonify({
            "error": "Le champ message doit être une chaîne."
        }), 400

    query = message.strip()

    if not query:
        return jsonify({
            "error": "Le message est vide."
        }), 400

    if len(query) > 10000:
        return jsonify({
            "error": "Message trop long. Maximum : 10 000 caractères."
        }), 413

    try:

        result = agent.invoke({
            "query": query,
            "debug": [],
            "tool_name": None,
            "tool_input": None,
            "tool_result": None,
            "tool_error": None,
            "route": None,
            "final_answer": None,
        })

        return jsonify({
            "answer": result.get(
                "final_answer",
                "Aucune réponse générée."
            ),
            "route": result.get("route") or "unknown",
            "tool": result.get("tool_name"),
            "debug": result.get("debug", []),
        })

    except Exception:

        logger.exception("Error processing chat request.")

        return jsonify({
            "error": (
                "Une erreur interne est survenue. "
                "Vérifie les logs du serveur."
            )
        }), 500


@app.get("/health")
def health():
    """
    Check Ollama availability and installed models.
    """

    try:

        response = requests.get(
            f"{OLLAMA_URL}/api/tags",
            timeout=3
        )

        response.raise_for_status()

        models = [
            item.get("name", "")
            for item in response.json().get("models", [])
        ]

        available = any(
            name == MODEL or name.startswith(MODEL + ":")
            for name in models
        )

        return jsonify({
            "status": "ok" if available else "warning",
            "ollama_reachable": True,
            "configured_model": MODEL,
            "model_available": available,
            "models": models,
            "hint": (
                None if available
                else f"Installe le modèle avec : ollama pull {MODEL}"
            ),
        }), 200

    except requests.RequestException:

        logger.exception("Ollama is not reachable.")

        return jsonify({
            "status": "error",
            "ollama_reachable": False,
            "configured_model": MODEL,
            "message": (
                "Ollama est inaccessible. "
                "Vérifie qu'il est installé et lancé."
            ),
        }), 503

    except (ValueError, KeyError):

        logger.exception("Invalid Ollama response.")

        return jsonify({
            "status": "error",
            "message": "Réponse invalide du serveur Ollama."
        }), 503


