def search_tool(query: str) -> str:
    """
    Search the local knowledge base.
    This function does not perform a live Internet search.
    """

    query_lower = query.lower().strip()

    for key, value in KNOWLEDGE_BASE.items():
        if key in query_lower:
            return value

    return (
        f"No specific local result was found for '{query}'. "
        "The local knowledge base does not contain "
        "enough information to answer this request."
    )


# ============================================================
# 6. JSON PARSER
# ============================================================

def parse_json_object(raw: str) -> dict:
    """
    Parse JSON returned by the model.
    Handles JSON wrapped in Markdown fences or extra text.
    """

    raw = raw.strip()

    try:
        result = json.loads(raw)

        if isinstance(result, dict):
            return result

    except json.JSONDecodeError:
        pass

    start = raw.find("{")
    end = raw.rfind("}")

    if start >= 0 and end > start:
        try:
            result = json.loads(raw[start:end + 1])

            if isinstance(result, dict):
                return result

        except json.JSONDecodeError:
            pass

    return {}


# ============================================================
# 7. SEARCH RESULT PROCESSOR
# ============================================================

def parse_search_results(query: str, search_results: str) -> str:
    """
    Generate a natural answer based on local search results.
    """

    prompt = f"""
Answer the user's question using the supplied information.

Rules:
- Be accurate, helpful and concise.
- Respond in the same language as the user.
- Do not invent facts that are absent from the context.
- If the context is insufficient, explain that clearly.
- Do not claim that you performed a live web search.

User question:
{query}

Available information:
{search_results}
"""

    return safe_llm_invoke(
        [
            SystemMessage(
                content="You are a helpful and accurate AI assistant."
            ),
            HumanMessage(content=prompt),
        ],
        default=search_results
    )


# ============================================================
# 8. NODE: CLASSIFY USER INPUT
# ============================================================

def classify_input(state: AgentState) -> dict:
    """
    Decide whether to use the calculator, local search,
    or a direct language-model response.
    """

    query = state["query"]

    debug = [
        f'User query: "{query}"'
    ]

    prompt = f"""
You are an AI request router.

Available options:

1. calculator:
Use only for numerical calculations that can be evaluated.

2. search:
Use for factual lookup that may be answered using a
small local knowledge base.

3. direct:
Use for conversations, explanations, programming,
equations containing variables, and other questions.

Return ONLY a valid JSON object in this format:
{{"tool": "calculator", "input": "12 * 8"}}

For search:
{{"tool": "search", "input": "Tunisia"}}

For direct:
{{"tool": "direct", "input": null}}

Calculator restrictions:
- Only use mathematical expressions.
- Never generate Python statements or imports.
- Supported functions: sqrt, pow, abs, round, min, max,
  log, log10, sin, cos, tan.
- Use ** for exponentiation.
- Do not solve symbolic equations using the calculator.

User request:
{query}
"""

    raw = safe_llm_invoke(
        [
            SystemMessage(
                content=(
                    "You are a strict request classifier. "
                    "Return valid JSON only."
                )
            ),
            HumanMessage(content=prompt),
        ],
        default='{"tool":"direct","input":null}'
    )

    debug.append(f"Model classification: {raw[:300]}")

    decision = parse_json_object(raw)

    tool_name = decision.get("tool", "direct")
    tool_input = decision.get("input")

    if tool_name not in {"calculator", "search", "direct"}:
        tool_name = "direct"
        tool_input = None

    if tool_input is not None and not isinstance(tool_input, str):
        tool_input = str(tool_input)

    if tool_name != "direct" and not tool_input:
        tool_name = "direct"
        tool_input = None

    debug.append(f"Selected route: {tool_name}")

    if tool_input:
        debug.append(f"Prepared input: {tool_input}")

    return {
        "tool_name": None if tool_name == "direct" else tool_name,
        "tool_input": tool_input,
        "route": "direct" if tool_name == "direct" else None,
        "debug": debug,
    }


# ============================================================
# 9. NODE: EXECUTE TOOL
# ============================================================

def execute_tool(state: AgentState) -> dict:
    """
    Execute the selected tool and capture errors.
    """

    tool_name = state.get("tool_name")
    tool_input = state.get("tool_input")

    debug = [
        f"Executing tool: {tool_name}"
    ]

    try:

        if tool_name == "calculator":

            if not tool_input:
                raise ValueError(
                    "No mathematical expression was provided."
                )

            result = calculator_tool(tool_input)

        elif tool_name == "search":

            if not tool_input:
                raise ValueError(
                    "No search query was provided."
                )

            search_results = search_tool(tool_input)

            result = parse_search_results(
                state["query"],
                search_results
            )

        else:
            raise ValueError(
                f"Unknown tool: {tool_name}"
            )

        debug.append(f"Tool result: {result[:300]}")

        return {
            "tool_result": result,
            "tool_error": None,
            "route": "tool",
            "debug": debug,
        }

    except Exception as error:

        logger.exception("Tool execution failed.")

        debug.append(
            f"Tool error: {type(error).__name__}: {error}"
        )

        return {
            "tool_result": None,
            "tool_error": str(error),
            "route": "fallback",
            "debug": debug,
        }


# ============================================================
# 10. NODE: DIRECT LLM ANSWER / FALLBACK
# ============================================================

def llm_answer(state: AgentState) -> dict:
    """
    Answer directly or provide a fallback if a tool fails.
    """

    query = state["query"]
    route = state.get("route") or "direct"

    system_prompt = """
You are a helpful AI assistant.

Rules:
- Answer in the same language as the user.
- Be clear, useful and accurate.
- For programming requests, provide practical explanations.
- Never claim a tool succeeded if it failed.
- If information is uncertain, say so.
"""

    if state.get("tool_error"):
        system_prompt += (
            "\nA tool failed while processing this request. "
            "Try to answer without pretending that the tool worked."
        )

    answer = safe_llm_invoke(
        [
            SystemMessage(content=system_prompt),
            HumanMessage(content=query),
        ],
        default=(
            "I cannot generate a response right now. "
            "Please check that Ollama is running and that "
            "the configured model is installed."
        )
    )

    return {
        "final_answer": answer,
        "route": route,
        "debug": [
            f"LLM response generated using route: {route}"
        ],
    }


# ============================================================
# 11. NODE: FORMAT OUTPUT
# ============================================================

def format_output(state: AgentState) -> dict:
    """
    Select the final answer from the graph state.
    """

    if (
        state.get("route") == "tool"
        and state.get("tool_result")
    ):
        answer = state["tool_result"]

    elif state.get("final_answer"):
        answer = state["final_answer"]

    else:
        answer = "I could not process your request."

    return {
        "final_answer": answer,
        "debug": [
            f"Final response prepared: {len(answer)} characters"
        ],
    }


# ============================================================
# 12. LANGGRAPH ROUTING
# ============================================================

def route_after_classify(state: AgentState) -> str:
    if state.get("tool_name"):
        return "execute_tool"

    return "llm_answer"


def route_after_tool(state: AgentState) -> str:
    if state.get("tool_error"):
        return "llm_answer"

    return "format_output"


# ============================================================
# 13. BUILD AGENT
# ============================================================

def build_agent():

    graph = StateGraph(AgentState)

    graph.add_node(
        "classify_input",
        classify_input
    )

    graph.add_node(
        "execute_tool",
        execute_tool
    )

    graph.add_node(
        "llm_answer",
        llm_answer
    )

    graph.add_node(
        "format_output",
        format_output
    )

    graph.add_edge(
        START,
        "classify_input"
    )

    graph.add_conditional_edges(
        "classify_input",
        route_after_classify
    )

    graph.add_conditional_edges(
        "execute_tool",
        route_after_tool
    )

    graph.add_edge(
        "llm_answer",
        "format_output"
    )

    graph.add_edge(
        "format_output",
        END
    )

    return graph.compile()


# Build the agent once at startup.
agent = build_agent()


