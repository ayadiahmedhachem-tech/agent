# ============================================================
# 2. AGENT STATE
# ============================================================

class AgentState(TypedDict, total=False):
    query: str
    tool_name: Optional[str]
    tool_input: Optional[str]
    tool_result: Optional[str]
    tool_error: Optional[str]
    route: Optional[str]
    final_answer: Optional[str]
    debug: Annotated[list[str], operator.add]


# ============================================================
# 3. LANGUAGE MODEL
# ============================================================

llm = ChatOllama(
    model=MODEL,
    base_url=OLLAMA_URL,
    temperature=0,
    num_predict=512
)


def safe_llm_invoke(messages, default=""):
    """
    Call the model safely.
    Return a fallback answer if Ollama fails.
    """
    try:
        response = llm.invoke(messages)
        content = response.content

        if isinstance(content, list):
            content = " ".join(
                item.get("text", "") if isinstance(item, dict)
                else str(item)
                for item in content
            )

        content = str(content).strip()

        if not content:
            logger.warning("The model returned an empty response.")
            return default

        return content

    except Exception:
        logger.exception("LLM invocation failed.")
        return default


# ============================================================
# 4. SAFE CALCULATOR
# ============================================================

ALLOWED_FUNCTIONS = {
    "sqrt": math.sqrt,
    "pow": math.pow,
    "abs": abs,
    "round": round,
    "min": min,
    "max": max,
    "log": math.log,
    "log10": math.log10,
    "sin": math.sin,
    "cos": math.cos,
    "tan": math.tan,
}

ALLOWED_CONSTANTS = {
    "pi": math.pi,
    "e": math.e,
}

BINARY_OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
}

UNARY_OPERATORS = {
    ast.UAdd: operator.pos,
    ast.USub: operator.neg,
}


def evaluate_math_node(node):
    """
    Evaluate a mathematical expression using an AST allowlist.
    Arbitrary Python code is not allowed.
    """

    if isinstance(node, ast.Expression):
        return evaluate_math_node(node.body)

    if isinstance(node, ast.Constant):
        if isinstance(node.value, (int, float)):
            if abs(node.value) > 1e100:
                raise ValueError("Number too large.")
            return node.value

        raise ValueError("Invalid constant.")

    if isinstance(node, ast.Name):
        if node.id in ALLOWED_CONSTANTS:
            return ALLOWED_CONSTANTS[node.id]

        raise ValueError(f"Unknown constant: {node.id}")

    if isinstance(node, ast.BinOp):
        operation = BINARY_OPERATORS.get(type(node.op))

        if operation is None:
            raise ValueError("Operator not allowed.")

        left = evaluate_math_node(node.left)
        right = evaluate_math_node(node.right)

        if isinstance(node.op, ast.Pow):
            if abs(right) > 1000:
                raise ValueError("Exponent too large.")

        result = operation(left, right)

        if isinstance(result, complex):
            raise ValueError("Complex results are not supported.")

        if isinstance(result, (int, float)):
            if not math.isfinite(result) or abs(result) > 1e100:
                raise ValueError("Result too large or invalid.")

        return result

    if isinstance(node, ast.UnaryOp):
        operation = UNARY_OPERATORS.get(type(node.op))

        if operation is None:
            raise ValueError("Unary operator not allowed.")

        return operation(evaluate_math_node(node.operand))

    if isinstance(node, ast.Call):
        if not isinstance(node.func, ast.Name):
            raise ValueError("Function not allowed.")

        function = ALLOWED_FUNCTIONS.get(node.func.id)

        if function is None or node.keywords:
            raise ValueError("Function not allowed.")

        arguments = [
            evaluate_math_node(argument)
            for argument in node.args
        ]

        result = function(*arguments)

        if isinstance(result, (int, float)):
            if not math.isfinite(result):
                raise ValueError("Result is not finite.")

        return result

    raise ValueError("Invalid mathematical expression.")


def calculator_tool(expression: str) -> str:
    """
    Calculate an expression safely.
    Supports:
        12 * 8
        sqrt(144) + 5
        2^10
        5²
        5³
        10 / 2
    """

    expression = expression.strip()

    expression = (
        expression
        .replace("^", "**")
        .replace("×", "*")
        .replace("÷", "/")
        .replace("π", "pi")
    )

    expression = re.sub(
        r"(\d+(?:\.\d+)?)\s*²\b",
        r"(\1**2)",
        expression
    )

    expression = re.sub(
        r"(\d+(?:\.\d+)?)\s*³\b",
        r"(\1**3)",
        expression
    )

    # Convert √9 to sqrt(9).
    expression = re.sub(
        r"√\s*(\d+(?:\.\d+)?)",
        r"sqrt(\1)",
        expression
    )

    if not expression or len(expression) > 250:
        raise ValueError("Empty expression or expression too long.")

    tree = ast.parse(expression, mode="eval")

    result = evaluate_math_node(tree)

    return str(result)


